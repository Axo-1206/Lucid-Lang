/// @file runtime-abi/functions.def
/// @brief The single source of truth for the runtime ABI surface.
///
/// ─── How To Read This File ─────────────────────────────────────────────────
/// This file is an X-macro table. It is not a header and is not #included
/// directly; it is #included by four consumers, each of which #defines
/// LUCID_RT to something different before including it:
///
///   1. src/codegen/Abi.hpp — defines the RuntimeFn enumerator rows and
///      emits one variadic member template per row.
///
///   2. src/codegen/Abi.cpp — builds the RuntimeFn → (symbol, tags) table
///      and the emitCall dispatch.
///
///   3. src/runtime/exports.cpp — emits the extern "C" prototypes that
///      the runtime implementations must match, and takes each function's
///      address into a table so its definition is forced to be linked.
///
///   4. src/interpreter/JITSession.cpp — builds the symbol name list the
///      JIT's DynamicLibrarySearchGenerator registers.
///
/// Because all of them read the same table, their views cannot drift.
/// Before this file existed, the CodeGen-side declaration, the runtime-side
/// definition, and the interpreter-side lookup each spelled the name and
/// signature independently; that is how __lucid_alloc_env's drop-callback
/// parameter drifted out of sync with its caller.
///
/// ─── Row Format ────────────────────────────────────────────────────────────
///   LUCID_RT(<EnumName>, "<symbol_name>", <ReturnType>, (<ParamTypes>))
///
/// ReturnType and ParamTypes use the following type tags. The full mapping
/// from tag to C++ type is in runtime-abi/lucid_abi.h, in the
/// "Type-tag mapping" section, and in runtime/exports.cpp for the pointer
/// variants.
///
///   Void     — no return value / no parameter
///   I1       — the ABI boolean (LucidBool, one byte at the C++ level)
///   I8       — int8 / Lucid char
///   I32      — int32 (used by char_to_str for the codepoint)
///   I64      — int64 / size / length / capacity / refcount
///   F64      — double
///   Ptr      — an opaque pointer with no statically-known pointee type
///   StrPtr   — a LucidString*
///   SlicePtr — a LucidSlice*
///   ArenaPtr — a LucidArena*
///   DescPtr  — a LucidArenaDescriptor*
///   Str      — LucidString BY VALUE (forbidden in parameter positions)
///   Slice    — LucidSlice BY VALUE (forbidden in parameter positions)
///   Arena    — LucidArena BY VALUE (forbidden in parameter positions)
///   Desc     — LucidArenaDescriptor BY VALUE (forbidden in parameter positions)
///
/// ─── The By-Pointer Convention ────────────────────────────────────────────
/// Struct types (`LucidString`, `LucidSlice`, `LucidArena`,
/// `LucidArenaDescriptor`) are never passed by value. LLVM and the platform
/// C ABI disagree about how to pass a struct by value — LLVM treats a
/// first-class aggregate parameter as a bundle of fields and passes them
/// individually, the platform C ABI treats the struct as a single unit and
/// passes it by hidden pointer (for structs larger than 16 bytes on the
/// two platforms Lucid targets) or in registers (for smaller) — and the
/// disagreement is silent until the call runs.
///
/// The rule: every struct-typed parameter uses the corresponding `*Ptr`
/// tag and is passed by pointer. The caller allocates the struct somewhere
/// (a stack slot for an argument, an out-slot for a result) and passes its
/// address; the callee dereferences the pointer.
///
/// The `Str`/`Slice`/`Arena`/`Desc` tags still exist for type identity —
/// `Abi.cpp`'s `llvmTypeForTag` maps them to the corresponding LLVM struct
/// types, which is what makes a `*Ptr` tag distinguishable from a `Ptr`
/// tag at the point where the pointer's pointee type matters — but they
/// must never appear in a row's parameter or return position.
/// `exports.cpp` expands the by-value tags to the struct type, so an
/// accidental use produces a prototype whose signature does not match the
/// runtime's pointer-based implementation, and the compiler rejects it.
/// `Abi.cpp` also asserts the convention in debug builds with a clearer
/// message.
///
/// ─── Adding A Row ──────────────────────────────────────────────────────────
/// Adding a row here is the *only* correct way to add a runtime function.
/// After adding a row:
///   1. Implement the function in src/runtime/ with the signature the row
///      implies. If the signature does not match the row,
///      src/runtime/exports.cpp fails to compile.
///   2. Call it from CodeGen via `abi.<EnumName>(builder, args...)`. Never
///      spell the symbol name at the call site.
///
/// ─── Ordering ──────────────────────────────────────────────────────────────
/// Grouped by subsystem, in the order the subsystems are presented in
/// Architecture.md §7. Order within a group is not significant, but
/// keeping the groups contiguous makes the table reviewable.

// ─── Closures ─────────────────────────────────────────────────────────────
//   void* __lucid_alloc_env(uint64_t size, void (*drop)(void*))
//     Allocates a closure environment. `drop` may be null.
//   void  __lucid_retain_env(void* env)
//     Increments the env's refcount. Null-safe.
//   void  __lucid_release_env(void* env)
//     Decrements the env's refcount; frees at zero. Null-safe.
LUCID_RT(AllocEnv,   "__lucid_alloc_env",   Ptr,  (I64, Ptr))
LUCID_RT(RetainEnv,  "__lucid_retain_env",  Void, (Ptr))
LUCID_RT(ReleaseEnv, "__lucid_release_env", Void, (Ptr))

// ─── Memory ───────────────────────────────────────────────────────────────
//   void* __lucid_alloc(uint64_t size)
//     The single heap allocation entry point. Everything heap-allocated in
//     Lucid — env blocks, string buffers, arena bases — goes through this.
//   void  __lucid_free(void* ptr)
//     The single heap free entry point. Null-safe. Every heap object is
//     released by exactly one call to this, from Ownership::drop.
//   void  __lucid_leak_report(void)
//     Prints the live-allocation count. Tests assert it reports zero.
LUCID_RT(Alloc,      "__lucid_alloc",       Ptr,  (I64))
LUCID_RT(Free,       "__lucid_free",        Void, (Ptr))
LUCID_RT(LeakReport, "__lucid_leak_report", Void, ())

// ─── Arena ────────────────────────────────────────────────────────────────
//   void   __lucid_arena_create(ArenaDescriptor* out, uint64_t size)
//     Writes a freshly allocated region's descriptor to *out. On failure,
//     out->base is null.
//   void*  __lucid_arena_alloc(Arena* arena, uint64_t size, uint64_t align)
//     Bumps the cursor. Returns null on out-of-capacity.
//   void   __lucid_arena_reset(Arena* arena)
//     Resets the cursor to 0. Does not free.
//   void   __lucid_arena_free(Arena* arena)
//     Frees the backing region. Called only from Ownership::drop.
//   uint64_t __lucid_arena_capacity(const Arena*)
//   uint64_t __lucid_arena_remaining(const Arena*)
//   bool     __lucid_arena_is_empty(const Arena*)
//   uint64_t __lucid_arena_space(const Arena*, uint64_t elem_size)
//   bool     __lucid_arena_can_fit(const Arena*, uint64_t elem_size, uint64_t count)
LUCID_RT(ArenaCreate,    "__lucid_arena_create",    Void, (DescPtr, I64))
LUCID_RT(ArenaAlloc,     "__lucid_arena_alloc",     Ptr,  (ArenaPtr, I64, I64))
LUCID_RT(ArenaReset,     "__lucid_arena_reset",     Void, (ArenaPtr))
LUCID_RT(ArenaFree,      "__lucid_arena_free",      Void, (ArenaPtr))
LUCID_RT(ArenaCapacity,  "__lucid_arena_capacity",  I64,  (ArenaPtr))
LUCID_RT(ArenaRemaining, "__lucid_arena_remaining", I64,  (ArenaPtr))
LUCID_RT(ArenaIsEmpty,   "__lucid_arena_is_empty",  I1,   (ArenaPtr))
LUCID_RT(ArenaSpace,     "__lucid_arena_space",     I64,  (ArenaPtr, I64))
LUCID_RT(ArenaCanFit,    "__lucid_arena_can_fit",   I1,   (ArenaPtr, I64, I64))

// ─── Strings ──────────────────────────────────────────────────────────────
//   void __lucid_str_concat(LucidString* out, LucidString* a, LucidString* b)
//     Writes the concatenation of *a and *b into *out. *out is a fresh
//     heap allocation; the caller owns it.
//
//   void __lucid_str_slice(LucidString* out, LucidString* s,
//                          int64 from, int64 to)
//     Writes the substring s[from..to) into *out. *out is a fresh heap
//     allocation.
//
//   bool __lucid_str_eq(LucidString* a, LucidString* b)
//     Length-then-bytes comparison. No allocation.
//
// All three pass the strings by pointer, per the by-pointer convention.
// The LucidString layout itself is unchanged; only the passing convention
// is.
LUCID_RT(StrConcat, "__lucid_str_concat", Void, (StrPtr, StrPtr, StrPtr))
LUCID_RT(StrSlice,  "__lucid_str_slice",  Void, (StrPtr, StrPtr, I64, I64))
LUCID_RT(StrEq,     "__lucid_str_eq",     I1,   (StrPtr, StrPtr))

// ─── Formatters (#tostr, #ptrstr) ─────────────────────────────────────────
//   All formatters use the out-pointer convention: the caller allocates
//   the result slot and passes its address, the runtime writes the string
//   into it.
//   bool_to_str takes I1 (LucidBool, one byte) rather than the C++ bool
//   because the C ABI does not guarantee bool-sized parameters; passing a
//   named one-byte type avoids the promotion mismatch that caused the
//   original segfault.
LUCID_RT(PtrToHexString, "__lucid_ptr_to_hex_string", Void, (StrPtr, Ptr))
LUCID_RT(BoolToStr,      "__lucid_bool_to_str",       Void, (StrPtr, I1))
LUCID_RT(CharToStr,      "__lucid_char_to_str",       Void, (StrPtr, I32))
LUCID_RT(IntToStr,       "__lucid_int_to_str",        Void, (StrPtr, I64))
LUCID_RT(UintToStr,      "__lucid_uint_to_str",       Void, (StrPtr, I64))
LUCID_RT(FloatToStr,     "__lucid_float_to_str",      Void, (StrPtr, F64))

// ─── Panic ────────────────────────────────────────────────────────────────
//   void __lucid_panic(const char* message)
//     Does not return. CodeGen marks the call site `noreturn`.
LUCID_RT(Panic, "__lucid_panic", Void, (Ptr))

// ─── Concurrency ──────────────────────────────────────────────────────────
//   The ABI is: the thunk owns a heap argument packet; it unpacks the
//   packet, frees it, calls the real function, and boxes the result. The
//   caller allocates the box's storage (out), or passes null for a discard.
//
//   void __lucid_async(void* thunk, void* packet, void** out)
//   void __lucid_spawn(void* thunk, void* packet, void** out)
//     out == null means "fire and forget". Otherwise the runtime writes the
//     handle into *out.
//   void* __lucid_await(void** handle_slot)
//   void* __lucid_join (void** handle_slot)
//     Consumes the handle (writes null back into *handle_slot), waits, and
//     returns a pointer to the boxed result. CodeGen loads the result out
//     of the box and frees the box.
//   void __lucid_shutdown(void)
//     Signals all threads to stop, waits, cleans up pending handles.
LUCID_RT(Async,    "__lucid_async",    Void, (Ptr, Ptr, Ptr))
LUCID_RT(Await,    "__lucid_await",    Ptr,  (Ptr))
LUCID_RT(Spawn,    "__lucid_spawn",    Void, (Ptr, Ptr, Ptr))
LUCID_RT(Join,     "__lucid_join",     Ptr,  (Ptr))
LUCID_RT(Shutdown, "__lucid_shutdown", Void, ())