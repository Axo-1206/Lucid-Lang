const makeAdder (base int) -> (int) -> int = {
    const add (x int) -> int = { return x + base; };
    return add;
};

@[export] const main () -> int = {
    let add5 (n int) -> int = makeAdder(5);
    let A int = 10;
    const B int = 20;

    add5 = (a int) -> int {
        return A + B;
    };

    return add5(10);
};