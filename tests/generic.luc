const factorial<T> (base T, p int) -> int = {
    let y T? = nil;
    if p <= 1 {
        return p;
    }
    return factorial<T>(base, p - 1);
};

const other2<T> (base T, p int) -> int = {
    return factorial<T>(base, p - 1);
};

struct Box<T> {
    value T;
}

